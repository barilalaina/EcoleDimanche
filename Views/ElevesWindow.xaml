<Window x:Class="EcoleDimanche.Views.ElevesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Élèves"
        Height="640" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FondApp}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Élèves" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextePrincipal}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="+ Ajouter" Style="{StaticResource BoutonPrimaire}" Click="Ajouter" Margin="0,0,8,0"/>
                <Button Content="Modifier" Style="{StaticResource BoutonSecondaire}" Click="Modifier" Margin="0,0,8,0"/>
                <Button Content="Supprimer" Style="{StaticResource BoutonDanger}" Click="Supprimer"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="CboFiltreClasse" Width="180" Padding="8,6" FontSize="13" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" SelectionChanged="FiltrerClasse"
                          DisplayMemberPath="NomClasse" ToolTip="Filtrer par classe"/>
                <TextBox x:Name="TxtRecherche" Width="220" Style="{StaticResource Champ}" Margin="0"
                         VerticalContentAlignment="Center" TextChanged="Rechercher"
                         ToolTip="Rechercher par nom, prénom ou parent"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="0">
            <DataGrid x:Name="Grille" Style="{StaticResource Grille}" BorderThickness="0"
                      MouseDoubleClick="Modifier">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="80"/>
                    <DataGridTextColumn Header="Naissance" Binding="{Binding DateNaissance}" Width="100"/>
                    <DataGridTextColumn Header="Classe" Binding="{Binding NomClasse}" Width="*"/>
                    <DataGridTextColumn Header="Tél. père" Binding="{Binding TelephonePere}" Width="110"/>
                    <DataGridTextColumn Header="Tél. mère" Binding="{Binding TelephoneMere}" Width="110"/>
                    <DataGridTextColumn Header="Baptisé" Binding="{Binding BaptiseText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
