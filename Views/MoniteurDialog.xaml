<Window x:Class="EcoleDimanche.Views.MoniteurDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moniteur"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource FondApp}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Nom *" Style="{StaticResource Libelle}"/>
            <TextBox x:Name="TxtNom" Style="{StaticResource Champ}"/>

            <TextBlock Text="Prénom *" Style="{StaticResource Libelle}"/>
            <TextBox x:Name="TxtPrenom" Style="{StaticResource Champ}"/>

            <TextBlock Text="Téléphone" Style="{StaticResource Libelle}"/>
            <TextBox x:Name="TxtTelephone" Style="{StaticResource Champ}"/>

            <TextBlock Text="Email" Style="{StaticResource Libelle}"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource Champ}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Style="{StaticResource BoutonSecondaire}" Click="Annuler" Margin="0,0,8,0"/>
            <Button Content="Enregistrer" Style="{StaticResource BoutonPrimaire}" Click="Enregistrer" MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>
