<Window x:Class="EcoleDimanche.Views.MoniteursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Moniteurs"
        Height="560" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FondApp}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Moniteurs" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextePrincipal}" Margin="0,0,0,14"/>

        <!-- Barre d'outils -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="+ Ajouter" Style="{StaticResource BoutonPrimaire}" Click="Ajouter" Margin="0,0,8,0"/>
                <Button Content="Modifier" Style="{StaticResource BoutonSecondaire}" Click="Modifier" Margin="0,0,8,0"/>
                <Button Content="Supprimer" Style="{StaticResource BoutonDanger}" Click="Supprimer"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="TxtRecherche" Width="220" Style="{StaticResource Champ}" Margin="0"
                         VerticalContentAlignment="Center" TextChanged="Rechercher"
                         ToolTip="Rechercher par nom, téléphone ou email"/>
            </StackPanel>
        </Grid>

        <!-- Grille -->
        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="0">
            <DataGrid x:Name="Grille" Style="{StaticResource Grille}" BorderThickness="0"
                      MouseDoubleClick="Modifier">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="130"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Inscription" Binding="{Binding DateInscription}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
