<Window x:Class="EcoleDimanche.Views.PresencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Présences"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FondApp}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Feuille de présence" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextePrincipal}" Margin="0,0,0,14"/>

        <!-- Filtres -->
        <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dimanche :" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,8,0"/>
                <DatePicker x:Name="DtpDate" Width="140" Padding="8,4" FontSize="13" Margin="0,0,20,0"
                            SelectedDateChanged="Date_Changed"/>
                <TextBlock Text="Classe :" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" Margin="0,0,8,0"/>
                <ComboBox x:Name="CboClasse" Width="200" Padding="8,6" FontSize="13"
                          DisplayMemberPath="NomClasse" SelectionChanged="Classe_Changed"/>
                <TextBlock x:Name="TxtCompteur" VerticalAlignment="Center" FontSize="13" Margin="20,0,0,0"
                           FontWeight="SemiBold" Foreground="{StaticResource Primaire}"/>
            </StackPanel>
        </Border>

        <!-- Grille éditable -->
        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="0">
            <DataGrid x:Name="Grille" Style="{StaticResource Grille}" BorderThickness="0"
                      IsReadOnly="False" CanUserAddRows="False"
                      CellEditEnding="Grille_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Élève" Binding="{Binding EleveNom}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Classe" Binding="{Binding NomClasse}" Width="*" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="Présent(e)" Binding="{Binding EstPresent, UpdateSourceTrigger=PropertyChanged}"
                                            Width="90"/>
                    <DataGridTextColumn Header="Remarque" Binding="{Binding Remarque, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Cochez les élèves présents, ajoutez éventuellement une remarque, puis enregistrez."
                       FontSize="12" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Enregistrer les présences" Style="{StaticResource BoutonPrimaire}"
                        Click="Enregistrer" MinWidth="190"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
